#!/usr/bin/env bash

read -p "Year: " year

if [ -e ./data/JoSAA-${year}-Round-1.csv ];
then
	declare -i count=$(grep -ne "[[:digit:]]P" ./data/JoSAA-${year}-Round-{1..6}.csv | wc -l);
	if [ $count -eq 0 ];
	then
		echo "The CSV datas for year ${year} has no trailing P";
	else
		grep -ne "[[:digit:]]P" ./data/JoSAA-${year}-Round-{1..6}.csv > ./notes/finding-trailing-p-${year};
		echo "Found trailing P data for the year ${year}";
	fi;
else
	echo "Could not find CSV data for the input year...";
fi;
