#!/usr/bin/env bash

read -p "Year: " year

if [ -e ./data/JoSAA-${year}-Round-1.csv ];
then
	declare -i count=$(grep -ne "\.0$" ./data/JoSAA-${year}-Round-{1..6}.csv | wc -l);
	if [ $count -eq 0 ];
	then
		echo "The CSV datas for year ${year} has no trailing zero";
	else
		grep -ne "\.0$" ./data/JoSAA-${year}-Round-{1..6}.csv > ./notes/finding-trailing-zero-${year};
		echo "Found trailing zero data for the year ${year}";
	fi;
else
	echo "Could not find CSV data for the input year...";
fi;
